<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.pathshala.listeners.ScreenshotListener"/>
    </listeners>
    <test name="SauceDemo UI Tests">
        <groups>
            <run>
                <exclude name="failing-demo"/>
            </run>
        </groups>
        <packages>
            <package name="com.pathshala.tests"/>
        </packages>
    </test>
</suite>
